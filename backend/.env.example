# AI Output Auditor — backend environment.
#
# Copy to backend/.env and fill in your key:
#     cp .env.example .env
#
# Two configuration sources, layered (see app/core/config.py):
#   - config/settings.yaml  — thresholds, weights, model selection. In the repo.
#   - this file             — secrets and per-deployment overrides. Never committed.
# The environment wins, so anything here overrides the YAML.

# ---------------------------------------------------------------------------
# LLM provider — Groq is active (see app/shared/llm_providers/groq.py).
# ---------------------------------------------------------------------------

# Required to run a real audit. Free key: https://console.groq.com/keys
# The scaffold boots without it; /health reports llm_configured: false.
GROQ_API_KEY=

# Switch providers by changing this key alone — no engine code changes
# (Document 4, §2). Currently registered: groq.
LLM_PROVIDER=groq

# Provider-qualified model id. Must be a model your key is currently served —
# Groq retires models (it removed qwen/qwen3-32b), and startup validation fails
# fast with the available list if this id is gone. llama-3.3-70b-versatile is a
# non-reasoning model with a 12000 tokens/minute free-tier limit; leave
# reasoning_format / reasoning_effort null for it in config/settings.yaml.
# Check GET /health -> llm_model_available to confirm the id is live.
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Paid provider (OpenRouter) — inactive.
#
# The provider is fully written (app/shared/llm_providers/openrouter.py) but not
# wired. To enable it:
#   1. Uncomment the PAID PROVIDER blocks in llm_providers/registry.py.
#   2. Uncomment the two lines below and add your key.
#   3. Set reasoning_format: null in config/settings.yaml (it is Groq-specific).
#
# The key is resolved per provider, so this can sit alongside GROQ_API_KEY —
# only the one matching LLM_PROVIDER is read.
# ---------------------------------------------------------------------------

# OPENROUTER_API_KEY=
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-sonnet-4.5

# Point at a compatible gateway. Leave unset to use the provider's default.
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | staging | production.
# In production a missing provider key fails startup rather than degrading
# every audit to Unable to Verify.
AUDITOR_ENVIRONMENT=development

AUDITOR_LOG_LEVEL=INFO

# text | json. Use json for machine ingestion in deployment.
AUDITOR_LOG_FORMAT=text

# Vite's dev server. Tighten for production.
AUDITOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Everything else uses the AUDITOR_ prefix with __ for nesting. These reach any
# field, including those with no flat alias above.
#
# Decision thresholds: Document 3 treats these as deployment configuration.
# Retuning one moves where the line sits; it can never change the rules —
# a qualifying critical finding always gates trust, and insufficient confidence
# always blocks a Trusted verdict.
# ---------------------------------------------------------------------------

# AUDITOR_LLM__TEMPERATURE=0.0
# AUDITOR_DECISION__MIN_TRUST_CONFIDENCE=0.60
# AUDITOR_DECISION__TRUST_BLOCKING_SEVERITY=high
# AUDITOR_EMBEDDING__CACHE_ENABLED=true
