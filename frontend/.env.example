# Frontend environment. Copy to frontend/.env.local to override.
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here — this file is compiled into client-side JavaScript that anyone can read.
# The LLM key belongs in backend/.env and nowhere else.

# Backend base URL. Defaults to '/api', which Vite proxies to
# http://127.0.0.1:8000 in development (see vite.config.ts). Set an absolute URL
# to point at a deployed backend.
VITE_API_BASE_URL=/api
